{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Article entity with title, markdown body, sources, category, tags, and status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "title_en": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "excerpt_en": { "type": "string" },
        "content": { "type": "string" },
        "content_en": { "type": "string" },
        "thumbnail": { "type": "string" },
        "images": { "type": "array" },
        "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "ARCHIVED"] },
        "categoryId": { "type": "string" },
        "tags": { "type": "array" },
        "metaTitle": { "type": "string" },
        "metaDesc": { "type": "string" },
        "agentNotes": { "type": "string" },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "slug", "content", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "News category matching top navigation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "Tag": {
      "title": "Tag",
      "description": "Topic tag",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "CMS User account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "passwordHash": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "EDITOR", "USER"] },
        "emailVerified": { "type": "boolean" },
        "failedLoginAttempts": { "type": "number" },
        "lockedUntil": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Article comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "articleId": { "type": "string" },
        "articleTitle": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "SPAM"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "articleId", "content", "status"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Site key-value settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["id", "key", "value"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security and activity log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userEmail": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "ipAddress": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userEmail", "action", "createdAt"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of all news articles"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of categories"
    },
    "/tags/{tagId}": {
      "schema": "Tag",
      "description": "Collection of tags"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of CMS users"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Collection of comments"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Collection of site settings"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Collection of audit logs"
    }
  }
}
