rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email == 'uugankhuub@gmail.com';
    }

    function isValidNews(data) {
      return data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
             data.lead is string && data.lead.size() <= 2000 &&
             data.body_markdown is string && data.body_markdown.size() <= 100000 &&
             data.status in ['draft', 'published'] &&
             data.sources is list;
    }

    match /news/{slug} {
      // Public can read only published news articles; admin can read drafts as well
      allow get, list: if resource.data.status == 'published' || isAdmin();

      // Writes from /api/news or admin creating drafts
      allow create: if (request.resource.data.status == 'draft' || isAdmin()) && isValidNews(request.resource.data);

      // Only admin email uugankhuub@gmail.com can update or delete
      allow update: if isAdmin() && isValidNews(request.resource.data);
      allow delete: if isAdmin();
    }

    match /slugs/{slug} {
      // Index of slugs for fast unique validation by server and creation flow
      allow read: if true;
      allow create: if request.resource.data.slug is string;
      allow delete: if isAdmin();
    }
  }
}
