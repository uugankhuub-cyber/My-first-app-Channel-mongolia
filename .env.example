# Application configuration
PORT=3000
SITE_URL=https://my-first-app-channel-mongolia-production.up.railway.app
CONTACT_EMAIL=uugankhuub@gmail.com

# Database Configuration
# If DATABASE_URL is empty, the application will fallback to a Mock In-Memory Database for testing.
# For production, supply a PostgreSQL connection string (e.g. Supabase, Neon, Cloud SQL)
DATABASE_URL=

# AI Integration
# Required for the Admin AI Assistant feature to generate/summarize content
GEMINI_API_KEY=

# Authentication (JWT)
JWT_SECRET=super_secret_key_change_me
JWT_REFRESH_SECRET=super_refresh_secret_key_change_me

# Initial Admin Credentials (used during DB seed if needed)
INITIAL_ADMIN_EMAIL=admin@channelmongolia.mn
INITIAL_ADMIN_PASSWORD=admin
ADMIN_SECRET=myadminsecret

# News System API Key (Server secret for POST /api/news ingestion)
NEWS_API_KEY=ch-mongolia-secret-news-key-2026

# Facebook Page Auto-Post (Graph API v26.0)
FB_PAGE_ID=
FB_PAGE_TOKEN=

